# Local Python virtual environments (never commit)
Include/
Lib/
Scripts/
etc/
share/
bin/
lib/
lib64/
pyvenv.cfg
anomalib-env/
.venv/

# Secrets & tokens (NEVER commit tokens!)
.env
.env.*
*token*
*secret*
*.pem
*.key

# Python / OS caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store
Thumbs.db

# Anomalib & OpenVINO build/runtime artifacts (keep .gitkeep)
anomaly/ov_cache/*
!anomaly/ov_cache/.gitkeep
anomaly/results/*
!anomaly/results/.gitkeep
anomaly/exports/*
!anomaly/exports/.gitkeep

# Raw & processed image/depth data (keep folder tree via .gitkeep)
data/calibration/*
!data/calibration/mat_A/
data/calibration/mat_A/*
!data/calibration/mat_A/.gitkeep
data/raw/**/*.png
data/raw/**/*.jpg
data/raw/**/*.jpeg
data/raw/**/*.bmp
data/raw/**/*.webp
data/raw/**/*.npy
data/processed/**/*
!data/processed/mat/
!data/processed/**/.gitkeep
!data/processed/**/train/
!data/processed/**/train/good/
!data/processed/**/test/
!data/processed/**/test/good/
!data/processed/**/test/defect/
!data/processed/**/ground_truth/
!data/processed/**/ground_truth/defect/
